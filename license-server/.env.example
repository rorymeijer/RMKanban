# Board License-server

APP_NAME="Board Licenties"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

# Database (interne defaults in docker-compose; niet aanraken).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=license
DB_USERNAME=license
DB_PASSWORD=license_internal_secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Ed25519-sleutelpaar. Laat leeg: het entrypoint genereert het bij de eerste
# start en persisteert het op het storage-volume. Of genereer zelf met:
#   php artisan license:keygen
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Basic-auth voor het adminpaneel — ZELF ZETTEN.
ADMIN_USER=admin
ADMIN_PASSWORD=verander-mij
