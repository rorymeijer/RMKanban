# Board — voorbeeldconfiguratie met werkende defaults.
#
# In de standaard Docker-opstelling worden deze waarden al door docker-compose.yml
# aan de containers meegegeven; je hoeft dit bestand dan NIET te kopiëren.
# In principe hoef je alleen APP_URL naar je eigen domein te zetten.
#
# De database, Redis/Valkey, Meilisearch en Reverb zijn al geconfigureerd en
# hoef je nooit aan te raken.

APP_NAME=rmboard
APP_ENV=production
# Leeg laten: het entrypoint genereert deze automatisch bij de eerste start.
APP_KEY=
APP_SECRET=
APP_DEBUG=false

# >>> Zet dit naar je eigen domein (via je bestaande Caddy). <<<
APP_URL=https://board.voorbeeld.nl

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

# Achter de proxy: vertrouw de forwarded headers van je Caddy.
TRUSTED_PROXIES=*

# Draait je Caddy zelf in Docker? Zet hier de naam van het (externe) Docker-
# netwerk waar jouw Caddy in zit en start met:
#   docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
# De web-service is dan op dat netwerk bereikbaar als "rmboard":
#   reverse_proxy rmboard:8080
CADDY_NETWORK=caddy

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Database (interne defaults, niet aanraken) -------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=board
DB_USERNAME=board
DB_PASSWORD=board_internal_secret

# --- Cache / sessions / queues via Valkey -------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=valkey
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# --- Zoeken (Meilisearch) -----------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=board_meili_master_key

# --- Realtime (Reverb via hetzelfde domein) -----------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=board
REVERB_APP_KEY=board_reverb_key
REVERB_APP_SECRET=board_reverb_secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Wat de browser gebruikt (via je Caddy, wss op poort 443):
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${APP_URL}"

# --- Applicatie-instellingen --------------------------------------------------
# Zelfregistratie standaard dicht.
REGISTRATION_OPEN=false
# Maximale uploadgrootte in MB.
MAX_UPLOAD_SIZE=25
# Retentie van het audit-log in dagen.
AUDIT_RETENTION_DAYS=365

# --- E-mail (optioneel; ook via de installer of het adminpaneel) --------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=board@localhost
MAIL_FROM_NAME="${APP_NAME}"

# --- SSO via OIDC (optioneel, Fase 7) -----------------------------------------
# OIDC_ENABLED=false
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=

# --- Licentie -----------------------------------------------------------------
# De licentie is "altijd aan" en zit in de code: als LEVERANCIER vul je je
# publieke Ed25519-sleutel + handhaving in config/license.php in (committed).
# Bewust GEEN LICENSE_* knoppen hier — de klant voert alleen zijn licentiesleutel
# in de installer in. (Voor lokale ontwikkeling kun je LICENSE_ENFORCE=false zetten.)

VITE_APP_NAME="${APP_NAME}"
